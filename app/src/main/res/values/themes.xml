<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BILIBILIAS" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 液态玻璃 UI（默认主题 · 平台 Material 兼容） -->
    <style name="Theme.LiquidGlass" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/glass_window_bg</item>
        <item name="android:colorPrimary">@color/glass_primary</item>
        <item name="android:colorAccent">@color/glass_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/glass_nav</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>